# Optional. Leave empty to keep data in the browser (localStorage).
# Set to a URL that answers GET (returns the data JSON) and PUT (stores it)
# to sync data with your website's backend. See README "Connecting to your website".
VITE_API_URL=
VITE_API_TOKEN=

# Host the app under a sub-path of your site, e.g. /finance/
VITE_BASE_PATH=/
